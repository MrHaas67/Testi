package work;

/**
 * A vehicle has an owner and drives with a certain speed which can also be zero or negative. A vehicle can change its speed.
 *
 *DO NOT CHANGE THE FILES Vehicle.java and Lockeable.java.
 *
 */
public class Vehicle {

	private int speed;
	private String owner;
	

	/**
	 * Initializes a vehicle with zero speed and a given owner
	 * @param owner name of the vehicle owner
	 */
	public Vehicle(String owner){
	this.owner = owner;
	speed = 0;
	}
	
	/**
	 * 
	 * @return the current speed of the vehicle
	 */
	public int getSpeed(){
	return speed;
	}
	
	/**
	 * Changes the speed of the vehicle by adding deltaSpeed to current speed. 
	 * @param deltaSpeed can be positive or negative
	 */
	public void accelerate(int deltaSpeed){
	speed += deltaSpeed;
	}
	
	/**
	 * @return the owner
	 */
	public String getOwner() {
		return owner;
	}
}
